{
    "name": "pzstudio",
    "displayName": "PZ Studio",
    "publisher": "escapepz",
    "version": "0.42200.0",
    "description": "Effortlessly create and maintain Lua mods for Project Zomboid with intuitive structuring.",
    "main": "./dist/extension.js",
    "type": "commonjs",
    "engines": {
        "vscode": "^1.102.0"
    },
    "categories": [
        "Other"
    ],
    "icon": "icon.png",
    "activationEvents": [],
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "pzstudio-container",
                    "title": "PZ Studio",
                    "icon": "media/pzstudio.png"
                }
            ]
        },
        "views": {
            "pzstudio-container": [
                {
                    "id": "pzstudio.projectExplorer",
                    "name": "PZ Project Explorer"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "pzstudio.explorer.toggleFiles",
                    "when": "view == pzstudio.projectExplorer",
                    "group": "navigation@1"
                },
                {
                    "command": "pzstudio.explorer.refresh",
                    "when": "view == pzstudio.projectExplorer",
                    "group": "navigation@3"
                }
            ],
            "view/item/context": [
                {
                    "command": "pzstudio.build",
                    "when": "view == pzstudio.projectExplorer && viewItem == project",
                    "group": "inline@1"
                },
                {
                    "command": "pzstudio.clean",
                    "when": "view == pzstudio.projectExplorer && viewItem == project",
                    "group": "inline@2"
                },
                {
                    "command": "pzstudio.modIncluded",
                    "when": "view == pzstudio.projectExplorer && (viewItem == mod-included || viewItem == mod-devonly)",
                    "group": "inline@1"
                },
                {
                    "command": "pzstudio.modExcluded",
                    "when": "view == pzstudio.projectExplorer && viewItem == mod-excluded",
                    "group": "inline@1"
                },
                {
                    "command": "pzstudio.modDevOnly.dim",
                    "when": "view == pzstudio.projectExplorer && (viewItem == mod-included || viewItem == mod-excluded)",
                    "group": "inline@2"
                },
                {
                    "command": "pzstudio.modDevOnly",
                    "when": "view == pzstudio.projectExplorer && viewItem == mod-devonly",
                    "group": "inline@2"
                },
                {
                    "command": "pzstudio.modinfoGenerate",
                    "when": "view == pzstudio.projectExplorer && viewItem =~ /^mod-(included|devonly|excluded)$/",
                    "group": "inline@4"
                },
                {
                    "command": "pzstudio.rename",
                    "when": "view == pzstudio.projectExplorer && viewItem =~ /^mod-(included|devonly|excluded)$/",
                    "group": "inline@5"
                },
                {
                    "command": "pzstudio.delete",
                    "when": "view == pzstudio.projectExplorer && viewItem =~ /^mod-(included|devonly|excluded)$/",
                    "group": "inline@6"
                },
                {
                    "command": "pzstudio.modConfigure",
                    "when": "view == pzstudio.projectExplorer && viewItem =~ /^mod/",
                    "group": "0_mod@1"
                },
                {
                    "command": "pzstudio.modinfoGenerate",
                    "when": "view == pzstudio.projectExplorer && viewItem =~ /^mod/",
                    "group": "1_mod@1"
                },
                {
                    "command": "pzstudio.rename",
                    "when": "view == pzstudio.projectExplorer && viewItem =~ /^mod/",
                    "group": "2_mod@1"
                },
                {
                    "command": "pzstudio.delete",
                    "when": "view == pzstudio.projectExplorer && viewItem =~ /^mod/",
                    "group": "3_mod"
                }
            ]
        },
        "taskDefinitions": [
            {
                "type": "pzstudio",
                "required": [
                    "target"
                ],
                "properties": {
                    "target": {
                        "type": "string",
                        "enum": [
                            "production",
                            "development",
                            "clean"
                        ],
                        "description": "Build target (production/development) or clean"
                    }
                }
            }
        ],
        "commandPalette": [
            {
                "command": "pzstudio.modIncluded",
                "when": "false"
            },
            {
                "command": "pzstudio.modExcluded",
                "when": "false"
            },
            {
                "command": "pzstudio.modDevOnly",
                "when": "false"
            },
            {
                "command": "pzstudio.modDevOnly.dim",
                "when": "false"
            }
        ],
        "jsonValidation": [
            {
                "fileMatch": "project.json",
                "url": "./schemas/pzstudio.schema.json"
            }
        ],
        "configuration": {
            "title": "PZ Studio",
            "properties": {
                "pzstudio.templates.project.url": {
                    "type": "string",
                    "description": "Repository URL for the default project template (e.g. https://github.com/org/repo.git)",
                    "scope": "resource",
                    "default": "https://github.com/escapepz/pzstudio-template-project.git"
                },
                "pzstudio.templates.project.ref": {
                    "type": "string",
                    "description": "Git ref (branch, tag, or commit) for the project template",
                    "scope": "resource",
                    "default": "42.17.0"
                },
                "pzstudio.templates.mod.url": {
                    "type": "string",
                    "description": "Repository URL for the default mod template",
                    "scope": "resource",
                    "default": "https://github.com/escapepz/pzstudio-template-mod.git"
                },
                "pzstudio.templates.mod.ref": {
                    "type": "string",
                    "description": "Git ref (branch, tag, or commit) for the mod template",
                    "scope": "resource",
                    "default": "42.17.0"
                },
                "pzstudio.templates.workshop.url": {
                    "type": "string",
                    "description": "Repository URL for the default workshop template",
                    "scope": "resource",
                    "default": "https://github.com/escapepz/pzstudio-template-workshop.git"
                },
                "pzstudio.templates.workshop.ref": {
                    "type": "string",
                    "description": "Git ref (branch, tag, or commit) for the workshop template",
                    "scope": "resource",
                    "default": "42.0"
                },
                "pzstudio.templates.language.url": {
                    "type": "string",
                    "description": "Repository URL for the default language template",
                    "scope": "resource",
                    "default": "https://github.com/escapepz/pzstudio-template-language.git"
                },
                "pzstudio.templates.language.ref": {
                    "type": "string",
                    "description": "Git ref (branch, tag, or commit) for the language template",
                    "scope": "resource",
                    "default": "42.13.1"
                },
                "pzstudio.outdir": {
                    "type": "string",
                    "description": "Default build output directory",
                    "scope": "resource",
                    "default": ""
                },
                "pzstudio.useSymlinks": {
                    "type": "boolean",
                    "description": "Whether to use symlinks instead of copying during build",
                    "scope": "resource",
                    "default": true
                },
                "pzstudio.verbose": {
                    "type": "boolean",
                    "description": "Enable verbose/diagnostic output for all commands (--verbose)",
                    "scope": "resource",
                    "default": false
                },
                "pzstudio.offline": {
                    "type": "boolean",
                    "description": "Skip remote template refresh and use cached/legacy data (--offline). Applies to New Project and Add Mod.",
                    "scope": "resource",
                    "default": false
                },
                "pzstudio.forceUpdate": {
                    "type": "boolean",
                    "description": "Force refresh of cached templates (--force-update). Applies to New Project and Add Mod.",
                    "scope": "resource",
                    "default": false
                },
                "pzstudio.build.target": {
                    "type": "string",
                    "enum": [
                        "default",
                        "production",
                        "development"
                    ],
                    "enumDescriptions": [
                        "Build the main workshop output (same as production)",
                        "Build the main workshop output (--production)",
                        "Build the dev_branch workshop output (--development)"
                    ],
                    "description": "Build target mode. Controls whether to build the main or dev_branch workshop output.",
                    "scope": "resource",
                    "default": "default"
                },
                "pzstudio.confirmBeforeRun": {
                    "type": "boolean",
                    "description": "Ask for confirmation before running Build or Clean (protects against misclicks while the game is debugging the output).",
                    "scope": "resource",
                    "default": true
                }
            }
        },
        "commands": [
            {
                "command": "pzstudio.new",
                "title": "PZStudio: New Project"
            },
            {
                "command": "pzstudio.add",
                "title": "PZStudio: Add Mod"
            },
            {
                "command": "pzstudio.build",
                "title": "PZStudio: Build",
                "icon": "$(play)"
            },
            {
                "command": "pzstudio.clean",
                "title": "PZStudio: Clean",
                "icon": "$(clear-all)"
            },
            {
                "command": "pzstudio.modIncluded",
                "title": "PZStudio: Included in Build (click to exclude)",
                "icon": "$(eye)"
            },
            {
                "command": "pzstudio.modDevOnly",
                "title": "PZStudio: dev_branch-only Build (click to turn off)",
                "icon": "$(beaker)"
            },
            {
                "command": "pzstudio.modDevOnly.dim",
                "title": "PZStudio: Build Mod in dev_branch Only",
                "icon": "media/beaker-dim.svg"
            },
            {
                "command": "pzstudio.modExcluded",
                "title": "PZStudio: Excluded from Build (click to include)",
                "icon": "$(eye-closed)"
            },
            {
                "command": "pzstudio.modConfigure",
                "title": "PZStudio: Edit Mod Configuration",
                "icon": "$(settings-gear)"
            },
            {
                "command": "pzstudio.delete",
                "title": "PZStudio: Delete Mod",
                "icon": "$(trash)"
            },
            {
                "command": "pzstudio.lang",
                "title": "PZStudio: New Language"
            },
            {
                "command": "pzstudio.rename",
                "title": "PZStudio: Rename Mod ID",
                "icon": "$(edit)"
            },
            {
                "command": "pzstudio.update",
                "title": "PZStudio: Update"
            },
            {
                "command": "pzstudio.modinfoGenerate",
                "title": "PZStudio: ModInfo Generate",
                "icon": "$(note)"
            },
            {
                "command": "pzstudio.explorer.refresh",
                "title": "PZStudio: Refresh Project Explorer",
                "icon": "$(refresh)"
            },
            {
                "command": "pzstudio.explorer.toggleFiles",
                "title": "PZStudio: Toggle All/Essential Files in Explorer",
                "icon": "$(eye)",
                "enablement": "view == pzstudio.projectExplorer"
            }
        ]
    },
    "homepage": "https://marketplace.visualstudio.com/items?itemName=escapepz.pzstudio",
    "repository": {
        "type": "git",
        "url": "https://github.com/escapepz/project-zomboid-studio.git",
        "directory": "packages/vscode-extension"
    },
    "bugs": {
        "url": "https://github.com/escapepz/project-zomboid-studio/issues"
    },
    "author": "escapepz",
    "contributors": [
        {
            "name": "escapepz",
            "url": "https://github.com/escapepz"
        },
        {
            "name": "asledgehammer",
            "url": "https://github.com/asledgehammer"
        },
        {
            "name": "demiurgeQuantified",
            "url": "https://github.com/demiurgeQuantified"
        }
    ],
    "funding": [
        {
            "type": "ko-fi",
            "url": "https://ko-fi.com/escapepz"
        },
        {
            "type": "ko-fi",
            "url": "https://ko-fi.com/konijima"
        }
    ],
    "license": "Apache-2.0",
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('./dist', { recursive: true, force: true })\"",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "bundle": "node scripts/bundle.js",
        "build": "pnpm run clean && pnpm run typecheck && pnpm run bundle",
        "vsce:package": "vsce package --no-dependencies",
        "watch": "pnpm run clean && node scripts/bundle.js --watch"
    },
    "devDependencies": {
        "@types/vscode": "^1.102.0",
        "@vscode/vsce": "^3.7.1",
        "esbuild": "^0.27.2"
    },
    "dependencies": {
        "pzstudio-cli": "workspace:*"
    }
}
