{
    "name": "pzstudio-workspace",
    "version": "0.42200.0",
    "private": true,
    "description": "Workspace root for the PZ Studio packages (CLI, core, platform adapters, VS Code extension).",
    "type": "commonjs",
    "pnpm": {
        "overrides": {
            "picomatch": "^2.3.2",
            "minimatch": "^3.1.4",
            "brace-expansion": "^1.1.13",
            "undici": "^7.24.0",
            "lodash": "^4.17.24"
        }
    },
    "scripts": {
        "clean": "pnpm -r clean",
        "build": "pnpm -r build",
        "pzstudio": "node packages/cli/dist/index.js",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:real-env": "vitest run --config vitest.real-env.config.ts",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@types/node": "^20.0.0",
        "@vitest/coverage-v8": "^4.1.4",
        "eslint": "^10.2.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^15.9.0",
        "lefthook": "^2.1.1",
        "prettier": "^3.7.4",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.58.2",
        "vitest": "^4.1.4"
    }
}
