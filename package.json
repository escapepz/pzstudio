{
    "name": "pzstudio-workspace",
    "version": "0.42200.0",
    "private": true,
    "description": "Workspace root for the PZ Studio packages (CLI, core, platform adapters, VS Code extension).",
    "type": "commonjs",
    "scripts": {
        "clean": "pnpm -r clean",
        "build": "pnpm -r build",
        "pzstudio": "node packages/cli/dist/index.js",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:real-env": "vitest run --config vitest.real-env.config.ts",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "20.19.39",
        "@vitest/coverage-v8": "4.1.12",
        "eslint": "10.2.1",
        "eslint-config-prettier": "10.1.8",
        "globals": "15.15.0",
        "lefthook": "2.1.1",
        "prettier": "3.7.4",
        "typescript": "5.9.3",
        "typescript-eslint": "8.58.2",
        "vitest": "4.1.12"
    }
}
