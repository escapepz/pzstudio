{
  "$schema": "https://tr.designtokens.org/format/",
  "pzStudio": {
    "color": {
      "nearBlack": {
        "$value": "#090A0B",
        "$type": "color",
        "$description": "Primary dark canvas & terminal background"
      },
      "darkSurface": {
        "$value": "#121416",
        "$type": "color",
        "$description": "Secondary panels, cards & IDE sidebars"
      },
      "elevatedSurface": {
        "$value": "#202327",
        "$type": "color",
        "$description": "Interactive controls, active tabs & badges"
      },
      "border": {
        "$value": "#353A40",
        "$type": "color",
        "$description": "1px structural hairlines & construction grids"
      },
      "secondaryText": {
        "$value": "#AEB4BB",
        "$type": "color",
        "$description": "Technical descriptors, CLI logs & muted labels"
      },
      "primaryWhite": {
        "$value": "#F8F8F6",
        "$type": "color",
        "$description": "Primary brand mark, display headings & light surface"
      }
    },
    "typography": {
      "display": {
        "$value": "Space Grotesk, Inter, sans-serif",
        "$type": "fontFamily"
      },
      "monospace": {
        "$value": "JetBrains Mono, Geist Mono, monospace",
        "$type": "fontFamily"
